{
  "name": "engineering-handbook",
  "version": "0.0.0",
  "private": true,
  "description": "Heirs Technologies Engineering Handbook — standards, templates, and checklists.",
  "type": "module",
  "scripts": {
    "lint:md": "markdownlint-cli2",
    "lint:links": "markdown-link-check --quiet --config .markdown-link-check.json --ignore docs/_source README.md CONTRIBUTING.md docs",
    "validate": "tsx scripts/validate-structure.ts",
    "index": "tsx scripts/generate-index.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write '**/*.md'"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "markdown-link-check": "^3.15.0",
    "markdownlint-cli2": "^0.13.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  },
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "keywords": []
}
